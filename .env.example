# Copy to .env at the repo root. Read by apps/api (Prisma) and apps/web (Next rewrites).

# Postgres from compose.yaml
DATABASE_URL=postgresql://petty:petty@localhost:5432/petty_tab

# Port the NestJS API listens on
API_PORT=3001

# Where Next.js proxies /api/* to (same-origin for the browser)
API_URL=http://localhost:3001

# AES-256-GCM key (32 bytes, base64) that encrypts invite tokens so the waiting card can show the link again.
# This value is for local development only. Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INVITE_KEY=BlzCG4Y7uf0WjElL7+zwBo47pGLC/Ig3OMmZriSNhCY=

# HMAC key (32 bytes, base64) that signs the short-lived /api/files URLs of rendered cards and reels (spec §11).
# This value is for local development only. Generate a real one per environment (same command as INVITE_KEY).
FILES_KEY=yiH2rKQ9pY0nQxV8b1u3cR7m5s0eWfT4aZ6dJ9kL2oM=

# Where rendered cards and reels are stored, shared by apps/api and apps/renderer. Relative paths resolve from
# each app's own directory, so the default is the repo's storage/ folder.
# STORAGE_DIR=../../storage

# End-to-end tests only: mounts POST /api/dev/seal. Playwright sets it for the API it starts; never in production.
# E2E_HOOKS=1
