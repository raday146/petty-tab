// spec §13. IDs are UUIDv7 from Postgres 18's uuidv7(); times are UTC.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  sessions   Session[]
  members    Member[]
  pushSubs   PushSub[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 hex of the cookie value; the value itself is never stored.
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("sessions")
}

model Pair {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  timezone  String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  /// The current cycle (spec §10); null until the second member joins. Charges carry it as week_start.
  cycleStart  DateTime? @map("cycle_start") @db.Timestamptz
  cycleEnd    DateTime? @map("cycle_end") @db.Timestamptz
  /// The one open deadline proposal (spec §10): set while open; proposalEnd null means "settle now".
  proposalBy  String?   @map("proposal_by") @db.Uuid
  proposalEnd DateTime? @map("proposal_end") @db.Timestamptz
  proposalAt  DateTime? @map("proposal_at") @db.Timestamptz
  members     Member[]
  invites     Invite[]
  charges     Charge[]
  verdicts    Verdict[]
  crimes      CustomCrime[]

  @@index([cycleEnd])
  @@map("pairs")
}

model Member {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pairId      String   @map("pair_id") @db.Uuid
  pair        Pair     @relation(fields: [pairId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String   @map("display_name")
  species     String
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz
  invites     Invite[]
  filed       Charge[] @relation("filer")
  accused     Charge[] @relation("accused")
  created     CustomCrime[] @relation("creator")
  chores      CustomCrime[] @relation("choreOwner")

  @@unique([pairId, species])
  @@index([userId])
  @@map("members")
}

model Invite {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pairId    String    @map("pair_id") @db.Uuid
  pair      Pair      @relation(fields: [pairId], references: [id], onDelete: Cascade)
  /// sha256 hex of the token, for lookup.
  tokenHash String    @unique @map("token_hash")
  /// AES-256-GCM of the token with INVITE_KEY, so the waiting card can show the same link again.
  tokenEnc  String    @map("token_enc")
  createdBy String    @map("created_by") @db.Uuid
  creator   Member    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  @@index([pairId])
  @@map("invites")
}

/// spec §8. The status set is a Postgres enum, so nothing else can be stored.
enum ChargeStatus {
  pending
  guilty
  appealed
  upheld
  dropped
}

model Charge {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pairId     String       @map("pair_id") @db.Uuid
  pair       Pair         @relation(fields: [pairId], references: [id], onDelete: Cascade)
  /// The start of the week the charge was filed in (spec §10); it stays there whatever happens later.
  weekStart  DateTime     @map("week_start") @db.Timestamptz
  filerId    String       @map("filer_id") @db.Uuid
  filer      Member       @relation("filer", fields: [filerId], references: [id], onDelete: Cascade)
  accusedId  String       @map("accused_id") @db.Uuid
  accused    Member       @relation("accused", fields: [accusedId], references: [id], onDelete: Cascade)
  /// A key of CRIMES in @petty-tab/shared, checked by the request schema.
  crimeKey   String       @map("crime_key")
  status     ChargeStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  pleadedAt  DateTime?    @map("pleaded_at") @db.Timestamptz
  resolvedAt DateTime?    @map("resolved_at") @db.Timestamptz
  /// When the accused's push went out, alone or in a batch (spec §12); null until then.
  pushedAt   DateTime?    @map("pushed_at") @db.Timestamptz

  @@index([pairId, weekStart])
  @@map("charges")
}

/// spec §10. One per pair and week: the unique key is what makes sealing idempotent.
model Verdict {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pairId           String    @map("pair_id") @db.Uuid
  pair             Pair      @relation(fields: [pairId], references: [id], onDelete: Cascade)
  weekStart        DateTime  @map("week_start") @db.Timestamptz
  weekEnd          DateTime  @map("week_end") @db.Timestamptz
  sealedAt         DateTime  @map("sealed_at") @db.Timestamptz
  /// Null on a tie; the snapshot keeps the members in join order then.
  winnerId         String?   @map("winner_id") @db.Uuid
  loserId          String?   @map("loser_id") @db.Uuid
  isTie            Boolean   @map("is_tie")
  /// VerdictSnapshot in @petty-tab/shared: names, animals, points and top crimes at sealing.
  snapshot         Json
  /// A key of SENTENCES in @petty-tab/shared; null on a tie.
  sentenceKey      String?   @map("sentence_key")
  sharedAt         DateTime? @map("shared_at") @db.Timestamptz
  sentenceLockedAt DateTime? @map("sentence_locked_at") @db.Timestamptz
  servedAt         DateTime? @map("served_at") @db.Timestamptz
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz
  /// Storage keys of the rendered card PNG and reel MP4 for the current sentence (spec §11); null until rendered.
  cardUrl          String?   @map("card_url")
  reelUrl          String?   @map("reel_url")
  /// The last halfway-point reminder sent to the loser (spec §12).
  remindedAt       DateTime? @map("reminded_at") @db.Timestamptz

  @@unique([pairId, weekStart])
  @@map("verdicts")
}

/// spec §6: a pair's own crimes. Charges store them as `custom:<id>` in crime_key.
model CustomCrime {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pairId       String     @map("pair_id") @db.Uuid
  pair         Pair       @relation(fields: [pairId], references: [id], onDelete: Cascade)
  createdBy    String     @map("created_by") @db.Uuid
  creator      Member     @relation("creator", fields: [createdBy], references: [id], onDelete: Cascade)
  /// User text, ≤ 40 and ≤ 80: shown as text, never passed to packages/art.
  title        String
  description  String
  /// A StickerKey and a UnitKey of @petty-tab/shared, checked by the request schema.
  sticker      String
  unit         String
  /// spec §8: set, a daily chore this member ticks; null, an ordinary crime.
  choreOwnerId String?    @map("chore_owner_id") @db.Uuid
  choreOwner   Member?    @relation("choreOwner", fields: [choreOwnerId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  /// Out of the picker; old charges and verdicts still read it.
  removedAt    DateTime?  @map("removed_at") @db.Timestamptz
  days         ChoreDay[]

  @@index([pairId])
  @@map("custom_crimes")
}

/// spec §8: one row per chore and local day, ticked done or charged as neglected. The key makes the
/// midnight sweep idempotent.
model ChoreDay {
  crimeId  String      @map("crime_id") @db.Uuid
  crime    CustomCrime @relation(fields: [crimeId], references: [id], onDelete: Cascade)
  /// The local date in the pair's timezone.
  day      DateTime    @db.Date
  doneAt   DateTime?   @map("done_at") @db.Timestamptz
  /// The charge filed when the day ended unticked.
  chargeId String?     @map("charge_id") @db.Uuid

  @@id([crimeId, day])
  @@map("chore_days")
}

/// spec §12: one Web Push subscription per device. A device that changes user moves over (unique endpoint).
model PushSub {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  /// { p256dh, auth } from PushSubscription.toJSON().keys
  keys      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("push_subs")
}
